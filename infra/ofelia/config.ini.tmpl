; ofelia schedule registry — replaces the old Dokploy schedules and the
; 7 GitHub-Actions scheduled-*.yml workflows.
;
; ofelia mounts the Docker socket and triggers other containers on cron.
; Two block types here:
;   [job-run "..."]   — start a fresh container on schedule (one-shot ingesters)
;   [job-exec "..."]  — exec a command inside an already-running container
;
; All times are server-local. Schedules use 6-field cron (sec min hr dom mon dow).
;
; This file is a TEMPLATE. ofelia does not interpolate ${VAR} itself and
; job-run containers do not inherit ofelia's own env, so the entrypoint
; renders it with envsubst at startup (see entrypoint.sh) into the actual
; config ofelia reads. The `environment = KEY=${KEY}` lines below are what
; pass real values into each spawned ingester container.
;
; The ingester images must be built before their schedules can fire. Build with:
;   npm run up:ingest
; (or `docker compose --profile ingest build`)

; ===================================================================
; Ingesters — wired up in docker-compose.yml today (13 of 27)
; (CORE + Unpaywall have compose services but no cron here: CORE needs a free
; CORE_API_KEY, Unpaywall is per-DOI enrichment. Run them via npm when ready.)
; ===================================================================

; Ingesters read Postgres via DATABASE_URL only (not the individual
; POSTGRES_* vars), so those are deliberately omitted here. Keeping
; POSTGRES_PASSWORD/USER/DB out of the rendered set also leaves the
; clicks-rollup command's `$$POSTGRES_*` escapes untouched by envsubst.

[job-run "ingester-pubmed"]
schedule = 0 0 */6 * * *
image = evidencelens-ingester-pubmed:local
network = evidencelens_evidencelens
environment = NCBI_API_KEY=${NCBI_API_KEY}
environment = NCBI_TOOL=${NCBI_TOOL}
environment = NCBI_EMAIL=${NCBI_EMAIL}
environment = NATS_URL=${NATS_URL}
environment = DATABASE_URL=${DATABASE_URL}
environment = S3_ENDPOINT=${S3_ENDPOINT}
environment = S3_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
environment = S3_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}
environment = S3_BUCKET=${S3_BUCKET}

