; ===================================================================
; In-cluster scheduled jobs that exec inside existing containers.
; Container names follow docker-compose's default: <project>-<service>-1.
; Project name is "evidencelens" (set at the top of docker-compose.yml).
; ===================================================================

; Weekly citation enrichment: compute inbound citation_count + PageRank from the
; Neo4j CITES graph and write them back to Neo4j + Meilisearch so "most cited" /
; "most influential" sorts work. The script computes PageRank too, so this
; replaces the old (dead) `/indexer pagerank-once` job. Runs inside the processor
; container, which has neo4j+meilisearch libs and NEO4J_*/MEILI_* env.
[job-exec "enrich-citations"]
schedule = 0 0 17 * * 0
container = evidencelens-processor-1
command = python /app/infra/scripts/enrich_citations.py

; Annual CMS Open Payments bulk load -> populates the open_payments table that
; drives every COIBadge. Triggers the long-running open-payments service's
; /run?url= endpoint (it streams the ZIP, extracts the General-Payment CSV, and
; COPY-loads Postgres). No-op if OPENPAYMENTS_BULK_URL is unset, so it's safe to
; leave scheduled. CMS publishes the prior program year by ~June 30 annually;
; run yearly in July. The container has wget (used by its own healthcheck).
[job-exec "open-payments-bulk"]
schedule = 0 0 6 5 7 *
container = evidencelens-ingester-open-payments-1
command = sh -c "test -n \"$$OPENPAYMENTS_BULK_URL\" && wget -qO- --post-data='' \"http://127.0.0.1:8080/run?url=$$OPENPAYMENTS_BULK_URL\" || echo 'OPENPAYMENTS_BULK_URL unset; skipping'"

; Weekly LTR retrain (clicks → XGBoost shadow deploy). Mondays 04:00.
[job-exec "ltr-train"]
schedule = 0 0 4 * * 1
container = evidencelens-scorer-1
command = python scripts/train_ltr.py --shadow

; Nightly clicks rollup.
[job-exec "clicks-rollup"]
schedule = 0 0 4 * * *
container = evidencelens-postgres-1
command = sh -c "PGPASSWORD=$$POSTGRES_PASSWORD psql -U $$POSTGRES_USER -d $$POSTGRES_DB -c 'INSERT INTO clicks_daily SELECT date_trunc(''day'', client_ts) AS day, query_text, count(*) FROM clicks WHERE client_ts >= now() - interval ''2 days'' GROUP BY day, query_text ON CONFLICT DO NOTHING;'"

